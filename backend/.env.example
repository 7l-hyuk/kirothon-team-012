# 복사해서 backend/.env 로 쓰세요. .env 는 커밋하지 않습니다.
# 값을 비워 두면 config.py 의 로컬 기본값을 씁니다.

# 비워 두면 AI를 부르지 않고 가짜 응답으로 동작합니다(X-Mock: true, /api/health 의 mock: true).
# 값을 넣으면 Claude를 호출합니다. 하루 호출 수는 기기 ID별로 AI_DAILY_LIMIT(기본 20)까지입니다.
ANTHROPIC_API_KEY=
# 기본 claude-opus-5-5. 날짜 접미사를 붙이지 않습니다.
CLAUDE_MODEL=
AI_DAILY_LIMIT=
DATABASE_URL=
S3_BUCKET=
AWS_REGION=
PRESIGN_EXPIRES_SECONDS=
UPLOAD_DIR=
STATIC_DIR=
