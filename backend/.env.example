# 복사해서 backend/.env 로 쓰세요. .env 는 커밋하지 않습니다.
# 값을 비워 두면 config.py 의 로컬 기본값을 씁니다.

# 비워 두면 AI를 부르지 않고 가짜 응답으로 동작합니다(X-Mock: true, /api/health 의 mock: true).
# 값을 넣으면 Claude를 호출합니다. 하루 호출 수는 기기 ID별로 AI_DAILY_LIMIT(기본 20)까지이고, DB(ai_usage)에 KST 날짜별로 셉니다.
ANTHROPIC_API_KEY=
# 기본 claude-opus-5-5. 날짜 접미사를 붙이지 않습니다.
CLAUDE_MODEL=
AI_DAILY_LIMIT=

# PostgreSQL 접속 주소. 예: postgresql+psycopg://shingo:<비밀번호>@localhost:5432/shingomate
# 로컬 개발은 호스트를 localhost 로 씁니다(db:5432 는 컨테이너 안에서만 통합니다).
# 앱이 시작할 때 테이블을 만들고, DB가 아직 없으면 2초 간격으로 15번까지 다시 시도합니다.
DATABASE_URL=

# 사진 저장소. S3_BUCKET 을 넣으면 S3 비공개 버킷을 쓰고(응답의 사진 url 은 presigned URL),
# 비워 두면 UPLOAD_DIR(기본 ./uploads) 디스크를 씁니다. /api/health 의 storage 가 "s3" 또는 "local" 입니다.
# AWS 액세스 키는 여기에도, 어디에도 두지 않습니다. EC2 의 IAM 역할을 boto3 가 자동으로 씁니다.
# (역할에 해당 버킷의 s3:PutObject, s3:GetObject 권한이 필요합니다. 로컬에서 S3를 시험하려면 AWS 프로필로 로그인해 두세요.)
S3_BUCKET=
AWS_REGION=
PRESIGN_EXPIRES_SECONDS=
UPLOAD_DIR=
STATIC_DIR=
